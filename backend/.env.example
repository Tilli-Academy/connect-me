# Backend environment variables (copy to .env and fill in real values)

# Server
PORT=3000
HOST=0.0.0.0

# CORS — the frontend origin allowed to call this API
CORS_ORIGIN=http://localhost:5173

# Database (required from Phase 1 onward)
DATABASE_URL=postgresql://carpool:carpool@localhost:5433/carpool?schema=public

# Auth (required from Phase 2 onward) — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Access-token lifetime (optional; default 7d). Refresh tokens are deferred post-MVP.
# JWT_EXPIRES_IN=7d
