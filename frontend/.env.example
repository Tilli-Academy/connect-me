# Frontend environment variables (copy to .env only if you need an override).
#
# Local development does NOT require this: the API client uses relative "/api" paths
# and the Vite dev-server proxy (see vite.config.js) forwards them to the backend.
#
# Set VITE_API_URL only for builds where the API lives on a different origin
# (e.g. a production deployment). Vite exposes only VITE_-prefixed vars.
# VITE_API_URL=https://api.example.com
